# Copie para `.env` e preencha. O `.env` de verdade não vai para o git.
#
# Tudo aqui é PÚBLICO por definição: o Vite embute estas variáveis no bundle
# que qualquer visitante baixa. Nunca ponha segredo neste arquivo nem no `.env`
# — STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ABACATEPAY_API_KEY,
# ABACATEPAY_WEBHOOK_SECRET e SUPABASE_SERVICE_ROLE_KEY vivem só nos secrets
# das Edge Functions, no painel do Supabase.
#
# A anon key é inofensiva sozinha: o que protege os dados é a RLS. `challenges`
# só devolve a linha de quem está logado, e `licenses` só deixa ler a própria.

# Obrigatórias. Sem elas o build falha, de propósito: um deploy sem estas duas
# sobe um site que não conecta em nada e mostra tela branca.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional. Analytics de funil (Plausible). Vazio = os eventos não saem do
# navegador. Preencha com o domínio exatamente como cadastrado no Plausible.
VITE_ANALYTICS_DOMAIN=

# Opcional. Quais contas veem o atalho do painel em Configurações, por ID de
# usuário separado por vírgula. É COSMÉTICO: quem libera o painel é a Edge
# Function `admin-dados`, conferindo o secret ADMIN_USER_IDS. Mantenha as duas
# listas iguais. Sem isto, vale o ID do dono que já está no código.
VITE_ADMIN_USER_IDS=
